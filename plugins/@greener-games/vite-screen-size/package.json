{
  "name": "@greener-games/vite-screen-size",
  "version": "1.0.2",
  "description": "Vite plugin to show screen size and breakpoints in dev mode.",
  "author": "Greener Games",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Greener-Games/Vite-Screen-Size.git",
    "directory": "plugins/@greener-games/vite-screen-size"
  },
  "bugs": {
    "url": "https://github.com/Greener-Games/Vite-Screen-Size/issues"
  },
  "homepage": "https://github.com/Greener-Games/Vite-Screen-Size#readme",
  "keywords": [
    "vite",
    "plugin",
    "screen",
    "size",
    "breakpoints",
    "responsive",
    "development"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.5",
    "typescript": "^5.4.4",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^4.0.0"
  }
}
